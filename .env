VITE_FIREBASE_AUTH_DOMAIN=anchorchet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=anchorchet
VITE_FIREBASE_STORAGE_BUCKET=anchorchet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=472601338498
VITE_FIREBASE_APP_ID=1:472601338498:web:eabe19cc7f6e41b735ca9b
