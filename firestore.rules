rules_version = '2';

// Anchorchet is a private two-person app, so the rules are an allowlist rather
// than "any signed-in user". Firebase Auth lets anyone create an account
// against your project by default — without the allowlist below, a stranger
// who found the app URL could sign up and read the whole database.
//
// The two accounts below are the only ones that can touch any data. To add or
// change a member, copy the UID from
// Firebase console -> Authentication -> Users and edit members() below.
service cloud.firestore {
  match /databases/{database}/documents {

    function members() {
      return [
        'ioVbP69SI6TRCdemMOiTVqp9jgG2', // Player 1 — the crafter
        '3OH4lfeofPY5iZUQ81FyHp0Dbz82'  // Player 2 — the anchor
      ];
    }

    function isMember() {
      return request.auth != null && request.auth.uid in members();
    }

    // Profiles: everyone in the household can read both, but you may only
    // write your own — this is what stops a role being reassigned remotely.
    match /users/{userId} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Shared collections. Both players read and write: he creates quests and
    // she advances them, she logs yarn and he marks a restock, and either can
    // post to the Hall of Fame.
    match /crochet_quests/{id}    { allow read, write: if isMember(); }
    match /yarn_stash/{id}        { allow read, write: if isMember(); }
    match /bowling_sessions/{id}  { allow read, write: if isMember(); }
    match /tournament_calendar/{id} { allow read, write: if isMember(); }
    match /hall_of_fame/{id}      { allow read, write: if isMember(); }
    match /hype_events/{id}       { allow read, write: if isMember(); }
    match /pattern_refs/{id}      { allow read, write: if isMember(); }
    match /bowling_arsenal/{id}   { allow read, write: if isMember(); }
    match /bowling_matches/{id}   { allow read, write: if isMember(); }
    match /yarn_wishlist/{id}     { allow read, write: if isMember(); }
    match /custom_projects/{id}   { allow read, write: if isMember(); }
    match /crochet_tutorials/{id} { allow read, write: if isMember(); }
    match /visual_glossary/{id}   { allow read, write: if isMember(); }

    // Anything not listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
